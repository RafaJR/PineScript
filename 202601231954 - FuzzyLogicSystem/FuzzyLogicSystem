//@version=6
indicator(title = 'Trend Meter')

// Inputs / Menus
PosNegPressure = input.bool(defval = true, title = 'Pos / Neg Pressure', tooltip = 'Positive Pressure   = RSI14 and Wave Trend Over Sold with WT Delta Pointing Up                                                               Negative Pressure = RSI14 and Wave Trend Over Bought with WT Delta Pointing Down', group = 'Signals')
TMSetups = input.bool(defval = true, title = 'Trend Meter Signal', tooltip = 'All 3 Trend Meters Now Align', group = 'Signals')
TMSetupsANDWT = input.bool(defval = true, title = 'Wave Trend Cross Aligns with Trend Meter Signal', group = 'Signals')
TrendBar1 = input.string(title = 'Trend Meter 1', defval = 'MACD Crossover - Fast - 8, 21, 5', options = ['MACD Crossover - 12, 26, 9', 'MACD Crossover - Fast - 8, 21, 5', 'Mom Dad Cross (Top Dog Trading)', 'RSI Signal Line Cross - RSI 13, Sig 21', 'RSI 13: > or < 50', 'RSI 5: > or < 50', 'Trend Candles', 'N/A'], group = 'Trend Meters')
TrendBar2 = input.string(title = 'Trend Meter 2', defval = 'RSI 13: > or < 50', options = ['MACD Crossover - 12, 26, 9', 'MACD Crossover - Fast - 8, 21, 5', 'Mom Dad Cross (Top Dog Trading)', 'RSI Signal Line Cross - RSI 13, Sig 21', 'RSI 13: > or < 50', 'RSI 5: > or < 50', 'Trend Candles', 'N/A'], group = 'Trend Meters')
TrendBar3 = input.string(title = 'Trend Meter 3', defval = 'RSI 5: > or < 50', options = ['MACD Crossover - 12, 26, 9', 'MACD Crossover - Fast - 8, 21, 5', 'Mom Dad Cross (Top Dog Trading)', 'RSI Signal Line Cross - RSI 13, Sig 21', 'RSI 13: > or < 50', 'RSI 5: > or < 50', 'Trend Candles', 'N/A'], group = 'Trend Meters')
DataSource = input.source(defval = close, title="Prize data source", group="General configuration")

//********************************************************************************************************************************************************************************************************************
// On fire booleans
// First line little balls
//    isPosNegPressureBullish
//    isPosNegPressureBearish
// Second line icons (+, .)
//    isBullishTrendBar
//    isBearishTrendBar
// First trend bar
//    isBullishTrendBar4
//    isBearishTrendBar4
// Second trend bar
//    isBullishTrendBar5
//    isBearishTrendBar5
//
//********************************************************************************************************************************************************************************************************************

// colors
colorLong = #95d697 // Green for bullish movements
colorShort = #eb805c // Red for bearish movements
colorNeutral = #9e9e9e5c // Grey color for ?

////////////////Signals - Wave Trend/////////////////////////////////////////////////////////////////////////////////////////////////
// Wave Trend - RSI
RSIMC = ta.rsi(DataSource, 14)

// Wave Trend
ap = hlc3
n1 = 9
n2 = 12
esa = ta.ema(ap, n1)
de = ta.ema(math.abs(ap - esa), n1)
ci = (ap - esa) / (0.015 * de)
tci = ta.ema(ci, n2)
wt1 = tci
wt2 = ta.sma(wt1, 3)

YellowWave = wt1 - wt2

obLevel2 = 60
obLevel = 50
osLevel = -50
osLevel2 = -60

// Wave Trend - Conditions
WTCross = ta.cross(wt1, wt2)
WTCrossUp = wt2 - wt1 <= 0
WTCrossDown = wt2 - wt1 >= 0
WTOverSold = wt2 <= osLevel2
WTOverBought = wt2 >= obLevel2

// MA Inputs
ShowTrendBar1 = input.bool(true, 'Trend Bar 1', group = 'Trend Bar 1', inline = 'Trend Bar 1')
ShowTrendBar2 = input.bool(true, 'Trend Bar 2', group = 'Trend Bar 2', inline = 'Trend Bar 2')
TrendBar4 = input.string(title = '', defval = 'MA Crossover', options = ['MA Crossover', 'MA Direction - Fast MA - TB1', 'MA Direction - Slow MA - TB1'], group = 'Trend Bar 1', inline = 'Trend Bar 1')
TrendBar5 = input.string(title = '', defval = 'MA Crossover', options = ['MA Crossover', 'MA Direction - Fast MA - TB2', 'MA Direction - Slow MA - TB2'], group = 'Trend Bar 2', inline = 'Trend Bar 2')

MA1_Length = input.int(5, title = 'Fast MA', minval = 1, group = 'Trend Bar 1', inline = 'TB1 Fast')
MA1_Type = input.string(title = '', defval = 'EMA', options = ['EMA', 'SMA'], group = 'Trend Bar 1', inline = 'TB1 Fast')

MA2_Length = input.int(11, title = 'Slow MA', minval = 1, group = 'Trend Bar 1', inline = 'TB1 Slow')
MA2_Type = input.string(title = '', defval = 'EMA', options = ['EMA', 'SMA'], group = 'Trend Bar 1', inline = 'TB1 Slow')

MA3_Length = input.int(13, title = 'Fast MA', minval = 1, group = 'Trend Bar 2', inline = 'TB2 Fast')
MA3_Type = input.string(title = '', defval = 'EMA', options = ['EMA', 'SMA'], group = 'Trend Bar 2', inline = 'TB2 Fast')

MA4_Length = input.int(36, title = 'Slow MA', minval = 1, group = 'Trend Bar 2', inline = 'TB2 Slow')
MA4_Type = input.string(title = '', defval = 'SMA', options = ['EMA', 'SMA'], group = 'Trend Bar 2', inline = 'TB2 Slow')


// MA Calculations

MA1 = if MA1_Type == 'SMA'
    ta.sma(DataSource, MA1_Length)
else
    ta.ema(DataSource, MA1_Length)

MA2 = if MA2_Type == 'SMA'
    ta.sma(DataSource, MA2_Length)
else
    ta.ema(DataSource, MA2_Length)

MA3 = if MA3_Type == 'SMA'
    ta.sma(DataSource, MA3_Length)
else
    ta.ema(DataSource, MA3_Length)

MA4 = if MA4_Type == 'SMA'
    ta.sma(DataSource, MA4_Length)
else
    ta.ema(DataSource, MA4_Length)

// MA Crossover Condition
MACrossover1 = MA1 > MA2 ? true : false
MACrossover2 = MA3 > MA4 ? true : false

// MA Direction Condition
MA1Direction = MA1 > MA1[1] ? true : false
MA2Direction = MA2 > MA2[1] ? true : false
MA3Direction = MA3 > MA3[1] ? true : false
MA4Direction = MA4 > MA4[1] ? true : false

// MACD and MOM & DAD - Top Dog Trading
// Standard MACD Calculations
MACDfastMA = 12
MACDslowMA = 26
MACDsignalSmooth = 9

MACDLine = ta.ema(DataSource, MACDfastMA) - ta.ema(DataSource, MACDslowMA)
SignalLine = ta.ema(MACDLine, MACDsignalSmooth)
MACDHistogram = MACDLine - SignalLine

// MACD- Background Color Change Condition
MACDHistogramCross = MACDHistogram > 0 ? true : false
MACDLineOverZero = MACDLine > 0 ? true : false

// Fast MACD Calculations
FastMACDfastMA = 8
FastMACDslowMA = 21
FastMACDsignalSmooth = 5
FastMACDLine = ta.ema(DataSource, FastMACDfastMA) - ta.ema(DataSource, FastMACDslowMA)
FastSignalLine = ta.ema(FastMACDLine, FastMACDsignalSmooth)
FastMACDHistogram = FastMACDLine - FastSignalLine

// Fast MACD- Background Color Change Condition
FastMACDHistogramCross = FastMACDHistogram > 0 ? true : false
FastMACDLineOverZero = FastMACDLine > 0 ? true : false

// Top Dog Trading - Mom Dad Calculations
TopDog_Fast_MA = 5
TopDog_Slow_MA = 20
TopDog_Sig = 30
TopDogMom = ta.ema(DataSource, TopDog_Fast_MA) - ta.ema(DataSource, TopDog_Slow_MA)
TopDogDad = ta.ema(TopDogMom, TopDog_Sig)

// Top Dog Dad - Background Color Change Condition
TopDogDadDirection = TopDogDad > TopDogDad[1] ? true : false
TopDogMomOverDad = TopDogMom > TopDogDad ? true : false
TopDogMomOverZero = TopDogMom > 0 ? true : false

////// Trend Barmeter Calculations //////
// UCS_Trend / Trend Candles Trend Barmeter Calculations
haDataSource = ohlc4
haopen = 0.0
haopen := na(haopen[1]) ? (open + DataSource) / 2 : (haopen[1] + haDataSource[1]) / 2

ccolor = haDataSource - haopen > 0 ? true : false

inside6 = haopen <= math.max(haopen[6], haDataSource[6]) and haopen >= math.min(haopen[6], haDataSource[6]) and haDataSource <= math.max(haopen[6], haDataSource[6]) and haDataSource >= math.min(haopen[6], haDataSource[6]) ? true : false
inside5 = haopen <= math.max(haopen[5], haDataSource[5]) and haopen >= math.min(haopen[5], haDataSource[5]) and haDataSource <= math.max(haopen[5], haDataSource[5]) and haDataSource >= math.min(haopen[5], haDataSource[5]) ? true : false
inside4 = haopen <= math.max(haopen[4], haDataSource[4]) and haopen >= math.min(haopen[4], haDataSource[4]) and haDataSource <= math.max(haopen[4], haDataSource[4]) and haDataSource >= math.min(haopen[4], haDataSource[4]) ? true : false
inside3 = haopen <= math.max(haopen[3], haDataSource[3]) and haopen >= math.min(haopen[3], haDataSource[3]) and haDataSource <= math.max(haopen[3], haDataSource[3]) and haDataSource >= math.min(haopen[3], haDataSource[3]) ? true : false
inside2 = haopen <= math.max(haopen[2], haDataSource[2]) and haopen >= math.min(haopen[2], haDataSource[2]) and haDataSource <= math.max(haopen[2], haDataSource[2]) and haDataSource >= math.min(haopen[2], haDataSource[2]) ? true : false
inside1 = haopen <= math.max(haopen[1], haDataSource[1]) and haopen >= math.min(haopen[1], haDataSource[1]) and haDataSource <= math.max(haopen[1], haDataSource[1]) and haDataSource >= math.min(haopen[1], haDataSource[1]) ? true : false

colorvalue = inside6 ? ccolor[6] : inside5 ? ccolor[5] : inside4 ? ccolor[4] : inside3 ? ccolor[3] : inside2 ? ccolor[2] : inside1 ? ccolor[1] : ccolor

TrendBarTrend_Candle_Color = colorvalue ? colorLong : colorShort
TrendBarTrend_Candle = colorvalue ? true : false

// RSI 5 Trend Barmeter Calculations
RSI5 = ta.rsi(DataSource, 5)
RSI5Above50 = RSI5 > 50 ? true : false
RSI5Color = RSI5Above50 ? colorLong : colorShort
TrendBarRSI5Color = RSI5Above50 ? colorLong : colorShort

// RSI 13 Trend Barmeter Calculations
RSI13 = ta.rsi(DataSource, 13)

// Linear Regression Calculation For RSI Signal Line
SignalLineLength1 = 21
x = bar_index
y = RSI13
x_ = ta.sma(x, SignalLineLength1)
y_ = ta.sma(y, SignalLineLength1)
mx = ta.stdev(x, SignalLineLength1)
my = ta.stdev(y, SignalLineLength1)
c = ta.correlation(x, y, SignalLineLength1)
slope = c * (my / mx)
inter = y_ - slope * x_
LinReg1 = x * slope + inter

RSISigDirection = LinReg1 > LinReg1[1]
RSISigCross = RSI13 > LinReg1
RSI13Above50 = RSI13 > 50

// Trend Barmeter Color Calculation
RSI13Color = RSI13Above50 ? colorLong : colorShort
TrendBarRSI13Color = RSI13Above50 ? colorLong : colorShort
TrendBarRSISigCrossColor = RSISigCross ? colorLong : colorShort
TrendBarMACDColor = MACDHistogramCross ? colorLong : colorShort
TrendBarFastMACDColor = FastMACDHistogramCross ? colorLong : colorShort
TrendBarMACrossColor = MACrossover1 ? colorLong : colorShort
TrendBarMomOverDadColor = TopDogMomOverDad ? colorLong : colorShort
TrendBarDadDirectionColor = TopDogDadDirection ? colorLong : colorShort

TrendBar1Result = TrendBar1 == 'MA Crossover' ? MACrossover1 : TrendBar1 == 'MACD Crossover - 12, 26, 9' ? MACDHistogramCross : TrendBar1 == 'MACD Crossover - Fast - 8, 21, 5' ? FastMACDHistogramCross : TrendBar1 == 'Mom Dad Cross (Top Dog Trading)' ? TopDogMomOverDad : TrendBar1 == 'DAD Direction (Top Dog Trading)' ? TopDogDadDirection : TrendBar1 == 'RSI Signal Line Cross - RSI 13, Sig 21' ? RSISigCross : TrendBar1 == 'RSI 5: > or < 50' ? RSI5Above50 : TrendBar1 == 'RSI 13: > or < 50' ? RSI13Above50 : TrendBar1 == 'Trend Candles' ? TrendBarTrend_Candle : false

TrendBar2Result = TrendBar2 == 'MA Crossover' ? MACrossover1 : TrendBar2 == 'MACD Crossover - 12, 26, 9' ? MACDHistogramCross : TrendBar2 == 'MACD Crossover - Fast - 8, 21, 5' ? FastMACDHistogramCross : TrendBar2 == 'Mom Dad Cross (Top Dog Trading)' ? TopDogMomOverDad : TrendBar2 == 'DAD Direction (Top Dog Trading)' ? TopDogDadDirection : TrendBar2 == 'RSI Signal Line Cross - RSI 13, Sig 21' ? RSISigCross : TrendBar2 == 'RSI 5: > or < 50' ? RSI5Above50 : TrendBar2 == 'RSI 13: > or < 50' ? RSI13Above50 : TrendBar2 == 'Trend Candles' ? TrendBarTrend_Candle : false

TrendBar3Result = TrendBar3 == 'MA Crossover' ? MACrossover1 : TrendBar3 == 'MACD Crossover - 12, 26, 9' ? MACDHistogramCross : TrendBar3 == 'MACD Crossover - Fast - 8, 21, 5' ? FastMACDHistogramCross : TrendBar3 == 'Mom Dad Cross (Top Dog Trading)' ? TopDogMomOverDad : TrendBar3 == 'DAD Direction (Top Dog Trading)' ? TopDogDadDirection : TrendBar3 == 'RSI Signal Line Cross - RSI 13, Sig 21' ? RSISigCross : TrendBar3 == 'RSI 5: > or < 50' ? RSI5Above50 : TrendBar3 == 'RSI 13: > or < 50' ? RSI13Above50 : TrendBar3 == 'Trend Candles' ? TrendBarTrend_Candle : false

TrendBars3Positive = TrendBar1Result and TrendBar2Result and TrendBar3Result ? true : false
TrendBars3Negative = not TrendBar1Result and not TrendBar2Result and not TrendBar3Result ? true : false

PositiveWaveTrendCross = WTCross and WTCrossUp
NegativeWaveTrendCross = WTCross and WTCrossDown

///////////////////////////////////////////////////////////////////////////////////////////////////////////////
isBullishTrendBar = TrendBars3Positive and not TrendBars3Positive[1]
isBearishTrendBar = TrendBars3Negative and not TrendBars3Negative[1]

// Signals Color Calculations
MSBar2Color = isBullishTrendBar ? colorLong : isBearishTrendBar ? colorShort : colorNeutral

// Trend Barmeter Color Assignments
TrendBar1Color = TrendBar1 == 'N/A' ? colorNeutral : TrendBar1 == 'MACD Crossover - 12, 26, 9' ? TrendBarMACDColor : TrendBar1 == 'MACD Crossover - Fast - 8, 21, 5' ? TrendBarFastMACDColor : TrendBar1 == 'Mom Dad Cross (Top Dog Trading)' ? TrendBarMomOverDadColor : TrendBar1 == 'DAD Direction (Top Dog Trading)' ? TrendBarDadDirectionColor : TrendBar1 == 'RSI Signal Line Cross - RSI 13, Sig 21' ? TrendBarRSISigCrossColor : TrendBar1 == 'RSI 5: > or < 50' ? TrendBarRSI5Color : TrendBar1 == 'RSI 13: > or < 50' ? TrendBarRSI13Color : TrendBar1 == 'Trend Candles' ? TrendBarTrend_Candle_Color : TrendBar1 == 'MA Crossover' ? TrendBarMACrossColor : colorNeutral
TrendBar2Color = TrendBar2 == 'N/A' ? colorNeutral : TrendBar2 == 'MACD Crossover - 12, 26, 9' ? TrendBarMACDColor : TrendBar2 == 'MACD Crossover - Fast - 8, 21, 5' ? TrendBarFastMACDColor : TrendBar2 == 'Mom Dad Cross (Top Dog Trading)' ? TrendBarMomOverDadColor : TrendBar2 == 'DAD Direction (Top Dog Trading)' ? TrendBarDadDirectionColor : TrendBar2 == 'RSI Signal Line Cross - RSI 13, Sig 21' ? TrendBarRSISigCrossColor : TrendBar2 == 'RSI 5: > or < 50' ? TrendBarRSI5Color : TrendBar2 == 'RSI 13: > or < 50' ? TrendBarRSI13Color : TrendBar2 == 'Trend Candles' ? TrendBarTrend_Candle_Color : TrendBar2 == 'MA Crossover' ? TrendBarMACrossColor : colorNeutral
TrendBar3Color = TrendBar3 == 'N/A' ? colorNeutral : TrendBar3 == 'MACD Crossover - 12, 26, 9' ? TrendBarMACDColor : TrendBar3 == 'MACD Crossover - Fast - 8, 21, 5' ? TrendBarFastMACDColor : TrendBar3 == 'Mom Dad Cross (Top Dog Trading)' ? TrendBarMomOverDadColor : TrendBar3 == 'DAD Direction (Top Dog Trading)' ? TrendBarDadDirectionColor : TrendBar3 == 'RSI Signal Line Cross - RSI 13, Sig 21' ? TrendBarRSISigCrossColor : TrendBar3 == 'RSI 5: > or < 50' ? TrendBarRSI5Color : TrendBar3 == 'RSI 13: > or < 50' ? TrendBarRSI13Color : TrendBar3 == 'Trend Candles' ? TrendBarTrend_Candle_Color : TrendBar3 == 'MA Crossover' ? TrendBarMACrossColor : colorNeutral

CrossoverType2 = TrendBar4 == 'DAD Direction (Top Dog Trading)' ? TopDogDadDirection : TrendBar4 == 'MACD Crossover' ? MACDHistogramCross : TrendBar4 == 'MA Direction - Fast MA - TB1' ? MA1Direction : TrendBar4 == 'MA Direction - Slow MA - TB1' ? MA2Direction : MACrossover1

isBullishTrendBar4 = TrendBar4 != 'N/A' and CrossoverType2
isBearishTrendBar4 = TrendBar4 != 'N/A' and not CrossoverType2

TrendBar4Color1 = isBullishTrendBar4 ? colorLong : isBearishTrendBar4 ? colorShort : colorNeutral


CrossoverType3 = TrendBar5 == 'DAD Direction (Top Dog Trading)' ? TopDogDadDirection : TrendBar5 == 'MACD Crossover' ? MACDHistogramCross : TrendBar5 == 'MA Direction - Fast MA - TB2' ? MA3Direction : TrendBar5 == 'MA Direction - Slow MA - TB2' ? MA4Direction : MACrossover2

isBullishTrendBar5 = TrendBar5 != 'N/A' and CrossoverType3
isBearishTrendBar5 = TrendBar5 != 'N/A' and not CrossoverType3
TrendBar5Color1 = isBullishTrendBar5 ? colorLong : isBearishTrendBar5 ? colorShort : colorNeutral

WTVOB = wt1 > 60
WTVOS = wt1 < -60

// Weekness / Pos/Neg Pressure
YellowWavePointingUp = YellowWave > YellowWave[1]

RSI14 = ta.rsi(DataSource, 14)
RSI14OB = RSI14 > 70 ? true : false
RSI14OS = RSI14 < 30 ? true : false

OBIndicatorsYellowPointingDown = (RSI14OB or RSI14OB[1]) and WTVOB and not YellowWavePointingUp
OSIndicatorsYellowPointingUp = (RSI14OS or RSI14OS[1]) and WTVOS and YellowWavePointingUp

isPosNegPressureBullish = PosNegPressure and OSIndicatorsYellowPointingUp
isPosNegPressureBearish = PosNegPressure and OBIndicatorsYellowPointingDown

plot(isPosNegPressureBullish ? 138.5 : na, 'Wave Trend - Positive Pressure', color = colorLong, style = plot.style_circles, linewidth = 2)
plot(isPosNegPressureBearish and OBIndicatorsYellowPointingDown ? 138.5 : na, 'Wave Trend - Negative Pressure', color = colorShort, style = plot.style_circles, linewidth = 2)
plot(TMSetups ? 134.5 : na, title = 'All 3 Trend Meters Now Align', style = plot.style_circles, color = MSBar2Color, linewidth = 3)
plot(TMSetupsANDWT and (PositiveWaveTrendCross and TrendBars3Positive or NegativeWaveTrendCross and TrendBars3Negative) ? 134.5 : na, title = 'Wave Trend X & All 3 Trend Meters Now Align', style = plot.style_cross, color = MSBar2Color, linewidth = 4)

// Trend Barmeter Plots
plot(128.5, title = 'Trend Meter 1', style = plot.style_circles, color = TrendBar1Color, linewidth = 2)
plot(122.5, title = 'Trend Meter 2', style = plot.style_circles, color = TrendBar2Color, linewidth = 2)
plot(116.5, title = 'Trend Meter 3', style = plot.style_circles, color = TrendBar3Color, linewidth = 2)

plot(ShowTrendBar1 and ShowTrendBar2 ? 110 : na, title = 'Trend Bar 1 - Thin Line', style = plot.style_line, color = TrendBar4Color1, linewidth = 4)
plot(ShowTrendBar1 and not ShowTrendBar2 ? 110 : na, title = 'Trend Bar 1 - Thick Line', style = plot.style_line, color = TrendBar4Color1, linewidth = 9)

plot(ShowTrendBar2 and ShowTrendBar1 ? 104.5 : na, title = 'Trend Bar 2 - Thin Line', style = plot.style_line, color = TrendBar5Color1, linewidth = 6)
plot(ShowTrendBar2 and not ShowTrendBar1 ? 110 : na, title = 'Trend Bar 2 - Thick Line', style = plot.style_line, color = TrendBar5Color1, linewidth = 9)

// Background Highlights
TrendBar3BarsSame = TrendBars3Positive ? colorLong : TrendBars3Negative ? colorShort : na
TMa = hline(113.7, color = color.new(color.white, 100))
TMb = hline(131.3, color = color.new(color.white, 100))
fill(TMa, TMb, color = color.new(TrendBar3BarsSame, 91), title = 'Trend Meter Background Highlight - 3 Trend Meter Conditions Met')