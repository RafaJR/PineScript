//@version=6
indicator(title = 'Trend Meter')

// String constants for option values
string OPT_MA_CROSSOVER = 'MA Crossover'
string OPT_MACD_CROSSOVER = 'MACD Crossover'
string OPT_MACD_CROSSOVER_12_26_9 = 'MACD Crossover - 12, 26, 9'
string OPT_MACD_CROSSOVER_FAST = 'MACD Crossover - Fast - 8, 21, 5'
string OPT_MOM_DAD_CROSS = 'Mom Dad Cross (Top Dog Trading)'
string OPT_DAD_DIRECTION = 'DAD Direction (Top Dog Trading)'
string OPT_RSI_SIG_CROSS = 'RSI Signal Line Cross - RSI 13, Sig 21'
string OPT_RSI_5_50 = 'RSI 5: > or < 50'
string OPT_RSI_13_50 = 'RSI 13: > or < 50'
string OPT_TREND_CANDLES = 'Trend Candles'
string OPT_NA = 'N/A'
string OPT_MA_DIR_FAST_TB1 = 'MA Direction - Fast MA - TB1'
string OPT_MA_DIR_SLOW_TB1 = 'MA Direction - Slow MA - TB1'
string OPT_MA_DIR_FAST_TB2 = 'MA Direction - Fast MA - TB2'
string OPT_MA_DIR_SLOW_TB2 = 'MA Direction - Slow MA - TB2'
string OPT_EMA = 'EMA'
string OPT_SMA = 'SMA'

//******************************************************************************************************************************************************
// Configuration inputs
//******************************************************************************************************************************************************
PosNegPressure = input.bool(defval = true, title = 'Pos / Neg Pressure', tooltip = 'Positive Pressure   = RSI14 and Wave Trend Over Sold with WT Delta Pointing Up                                                               Negative Pressure = RSI14 and Wave Trend Over Bought with WT Delta Pointing Down', group = 'Signals')
TMSetups = input.bool(defval = true, title = 'Trend Meter Signal', tooltip = 'All 3 Trend Meters Now Align', group = 'Signals')
TMSetupsANDWT = input.bool(defval = true, title = 'Wave Trend Cross Aligns with Trend Meter Signal', group = 'Signals')
TrendBar1 = input.string(title = 'Trend Meter 1', defval = OPT_MACD_CROSSOVER_FAST, options = [OPT_MACD_CROSSOVER_12_26_9, OPT_MACD_CROSSOVER_FAST, OPT_MOM_DAD_CROSS, OPT_RSI_SIG_CROSS, OPT_RSI_13_50, OPT_RSI_5_50, OPT_TREND_CANDLES, OPT_NA], group = 'Trend Meters')
TrendBar2 = input.string(title = 'Trend Meter 2', defval = OPT_RSI_13_50, options = [OPT_MACD_CROSSOVER_12_26_9, OPT_MACD_CROSSOVER_FAST, OPT_MOM_DAD_CROSS, OPT_RSI_SIG_CROSS, OPT_RSI_13_50, OPT_RSI_5_50, OPT_TREND_CANDLES, OPT_NA], group = 'Trend Meters')
TrendBar3 = input.string(title = 'Trend Meter 3', defval = OPT_RSI_5_50, options = [OPT_MACD_CROSSOVER_12_26_9, OPT_MACD_CROSSOVER_FAST, OPT_MOM_DAD_CROSS, OPT_RSI_SIG_CROSS, OPT_RSI_13_50, OPT_RSI_5_50, OPT_TREND_CANDLES, OPT_NA], group = 'Trend Meters')
DataSource = input.source(defval = close, title="Prize data source", group="General configuration")
// Averange calculation parameters
maType = input.string("VWMA", "Basis MA Type", options = ["SMA", "EMA", "SMMA (RMA)", "WMA", "VWMA"], group="Averange")
fastEmaPeriod = input.int(50, title="Fast EMA", minval=1, step=10, inline="Fast EMA", group="EMAs")
slowEmaPeriod = input.int(200, title="Slow EMA", minval=1, step=10, inline="Slow EMA", group="EMAs")

// Fuzzy logic Inputs
isPosNegPressureBullishWeight = input.float(title = 'isPosNegPressureBullishWeight', defval = 0, minval = 0, maxval = 100, group = "Fuzzy logic", step = 1)
isPosNegPressureBearishWeight = input.float(title = 'isPosNegPressureBearish', defval = 0, minval = 0, maxval = 100, group = "Fuzzy logic", step = 1)
isBullishTrendBarWeight = input.float(title = 'isBullishTrendBarWeight', defval = 0, minval = 0, maxval = 100, group = "Fuzzy logic", step = 1)
isBearishTrendBarWeight = input.float(title = 'isBearishTrendBarWeight', defval = 0, minval = 0, maxval = 100, group = "Fuzzy logic", step = 1)
MACDHistogramCrossWeight = input.float(title = 'MACDHistogramCrossWeight', defval = 1, minval = 0, maxval = 100, group = "Fuzzy logic", step = 1)
FastMACDHistogramCrossWeight = input.float(title = 'FastMACDHistogramCrossWeight', defval = 1, minval = 0, maxval = 100, group = "Fuzzy logic", step = 1)
TopDogMomOverDadWeight = input.float(title = 'TopDogMomOverDadWeight', defval = 1, minval = 0, maxval = 100, group = "Fuzzy logic", step = 1)
TopDogDadDirectionWeight = input.float(title = 'TopDogDadDirectionWeight', defval = 1, minval = 0, maxval = 100, group = "Fuzzy logic", step = 1)
RSISigCrossWeight = input.float(title = 'RSISigCrossWeight', defval = 1, minval = 0, maxval = 100, group = "Fuzzy logic", step = 1)
RSI5Above50Weight = input.float(title = 'RSI5Above50Weight', defval = 1, minval = 0, maxval = 100, group = "Fuzzy logic", step = 1)
RSI13Above50Weight = input.float(title = 'RSI13Above50Weight', defval = 1, minval = 0, maxval = 100, group = "Fuzzy logic", step = 1)
colorvalueWeight = input.float(title = 'colorvalueWeight', defval = 1, minval = 0, maxval = 100, group = "Fuzzy logic", step = 1)
MACrossover1Weight = input.float(title = 'MACrossover1Weight', defval = 1, minval = 0, maxval = 100, group = "Fuzzy logic", step = 1)
isBullishTrendBar4Weight = input.float(title = 'isBullishTrendBar4Weight', defval = 1, minval = 0, maxval = 100, group = "Fuzzy logic", step = 1)
isBearishTrendBar4Weight = input.float(title = 'isBearishTrendBar4Weight', defval = 1, minval = 0, maxval = 100, group = "Fuzzy logic", step = 1)
isBullishTrendBar5Weight = input.float(title = 'isBullishTrendBar5Weight', defval = 1, minval = 0, maxval = 100, group = "Fuzzy logic", step = 1)
isBearishTrendBar5Weight = input.float(title = 'isBearishTrendBar5Weight', defval = 1, minval = 0, maxval = 100, group = "Fuzzy logic", step = 1)
isMaBullishWeight = input.float(title = 'isMaBullishWeight', defval = 1, minval = 0, maxval = 100, group = "Fuzzy logic", step = 1)
isMaBearishWeight = input.float(title = 'isMaBearishWeight', defval = 1, minval = 0, maxval = 100, group = "Fuzzy logic", step = 1)

bullishSignalPercent = input.float(title = 'bullishSignalPercent', defval = 80, minval = 0, maxval = 100, group = "Fuzzy logic", step = 1)
bearishSignalPercent = input.float(title = 'bullishSignalPercent', defval = -80, minval =-100, maxval = 0, group = "Fuzzy logic", step = 1)

//********************************************************************************************************************************************************************************************************************
// On fire booleans (true=green / false=red)
// First line little balls
//    isPosNegPressureBullish
//    isPosNegPressureBearish
// Second line icons (+, .)
//    isBullishTrendBar
//    isBearishTrendBar
// First trend bar
//  OPT_MACD_CROSSOVER_12_26_9 	MACDHistogramCross
//  OPT_MACD_CROSSOVER_FAST	    FastMACDHistogramCross
//  OPT_MOM_DAD_CROSS	        TopDogMomOverDad
//  OPT_DAD_DIRECTION	        TopDogDadDirection
//  OPT_RSI_SIG_CROSS	        RSISigCross
//  OPT_RSI_5_50	            RSI5Above50
//  OPT_RSI_13_50	            RSI13Above50
//  OPT_TREND_CANDLES	        colorvalue
//  OPT_MA_CROSSOVER	        MACrossover1
// First trend bar
//    isBullishTrendBar4
//    isBearishTrendBar4
// Second trend bar
//    isBullishTrendBar5
//    isBearishTrendBar5
//
//********************************************************************************************************************************************************************************************************************

// colors
colorLong = #95d697 // Green for bullish movements
colorShort = #eb805c // Red for bearish movements
colorNeutral = #9e9e9e5c // Grey color for ?

//******************************************************************************************************************************************************
// Main indicators calculations
//******************************************************************************************************************************************************
// Wave Trend - RSI
RSIMC = ta.rsi(DataSource, 14)

// Wave Trend
ap = hlc3
n1 = 9
n2 = 12
esa = ta.ema(ap, n1)
de = ta.ema(math.abs(ap - esa), n1)
ci = (ap - esa) / (0.015 * de)
tci = ta.ema(ci, n2)
wt1 = tci
wt2 = ta.sma(wt1, 3)

YellowWave = wt1 - wt2

obLevel2 = 60
obLevel = 50
osLevel = -50
osLevel2 = -60

// Wave Trend - Conditions
WTCross = ta.cross(wt1, wt2)
WTCrossUp = wt2 - wt1 <= 0
WTCrossDown = wt2 - wt1 >= 0
WTOverSold = wt2 <= osLevel2
WTOverBought = wt2 >= obLevel2

// MA Inputs
ShowTrendBar1 = input.bool(true, 'Trend Bar 1', group = 'Trend Bar 1', inline = 'Trend Bar 1')
ShowTrendBar2 = input.bool(true, 'Trend Bar 2', group = 'Trend Bar 2', inline = 'Trend Bar 2')
TrendBar4 = input.string(title = '', defval = OPT_MA_CROSSOVER, options = [OPT_MA_CROSSOVER, OPT_MA_DIR_FAST_TB1, OPT_MA_DIR_SLOW_TB1], group = 'Trend Bar 1', inline = 'Trend Bar 1')
TrendBar5 = input.string(title = '', defval = OPT_MA_CROSSOVER, options = [OPT_MA_CROSSOVER, OPT_MA_DIR_FAST_TB2, OPT_MA_DIR_SLOW_TB2], group = 'Trend Bar 2', inline = 'Trend Bar 2')

MA1_Length = input.int(5, title = 'Fast MA', minval = 1, group = 'Trend Bar 1', inline = 'TB1 Fast')
MA1_Type = input.string(title = '', defval = OPT_EMA, options = [OPT_EMA, OPT_SMA], group = 'Trend Bar 1', inline = 'TB1 Fast')

MA2_Length = input.int(11, title = 'Slow MA', minval = 1, group = 'Trend Bar 1', inline = 'TB1 Slow')
MA2_Type = input.string(title = '', defval = OPT_EMA, options = [OPT_EMA, OPT_SMA], group = 'Trend Bar 1', inline = 'TB1 Slow')

MA3_Length = input.int(13, title = 'Fast MA', minval = 1, group = 'Trend Bar 2', inline = 'TB2 Fast')
MA3_Type = input.string(title = '', defval = OPT_EMA, options = [OPT_EMA, OPT_SMA], group = 'Trend Bar 2', inline = 'TB2 Fast')

MA4_Length = input.int(36, title = 'Slow MA', minval = 1, group = 'Trend Bar 2', inline = 'TB2 Slow')
MA4_Type = input.string(title = '', defval = OPT_SMA, options = [OPT_EMA, OPT_SMA], group = 'Trend Bar 2', inline = 'TB2 Slow')


// MA Calculations

MA1 = if MA1_Type == OPT_SMA
    ta.sma(DataSource, MA1_Length)
else
    ta.ema(DataSource, MA1_Length)

MA2 = if MA2_Type == OPT_SMA
    ta.sma(DataSource, MA2_Length)
else
    ta.ema(DataSource, MA2_Length)

MA3 = if MA3_Type == OPT_SMA
    ta.sma(DataSource, MA3_Length)
else
    ta.ema(DataSource, MA3_Length)

MA4 = if MA4_Type == OPT_SMA
    ta.sma(DataSource, MA4_Length)
else
    ta.ema(DataSource, MA4_Length)

// MA Crossover Condition
MACrossover1 = MA1 > MA2 ? true : false
MACrossover2 = MA3 > MA4 ? true : false

// MA Direction Condition
MA1Direction = MA1 > MA1[1] ? true : false
MA2Direction = MA2 > MA2[1] ? true : false
MA3Direction = MA3 > MA3[1] ? true : false
MA4Direction = MA4 > MA4[1] ? true : false

// MACD and MOM & DAD - Top Dog Trading
// Standard MACD Calculations
MACDfastMA = 12
MACDslowMA = 26
MACDsignalSmooth = 9

MACDLine = ta.ema(DataSource, MACDfastMA) - ta.ema(DataSource, MACDslowMA)
SignalLine = ta.ema(MACDLine, MACDsignalSmooth)
MACDHistogram = MACDLine - SignalLine

// MACD- Background Color Change Condition
MACDHistogramCross = MACDHistogram > 0
MACDLineOverZero = MACDLine > 0

// Fast MACD Calculations
FastMACDfastMA = 8
FastMACDslowMA = 21
FastMACDsignalSmooth = 5
FastMACDLine = ta.ema(DataSource, FastMACDfastMA) - ta.ema(DataSource, FastMACDslowMA)
FastSignalLine = ta.ema(FastMACDLine, FastMACDsignalSmooth)
FastMACDHistogram = FastMACDLine - FastSignalLine

// Fast MACD- Background Color Change Condition
FastMACDHistogramCross = FastMACDHistogram > 0
FastMACDLineOverZero = FastMACDLine > 0

// Top Dog Trading - Mom Dad Calculations
TopDog_Fast_MA = 5
TopDog_Slow_MA = 20
TopDog_Sig = 30
TopDogMom = ta.ema(DataSource, TopDog_Fast_MA) - ta.ema(DataSource, TopDog_Slow_MA)
TopDogDad = ta.ema(TopDogMom, TopDog_Sig)

// Top Dog Dad - Background Color Change Condition
TopDogDadDirection = TopDogDad > TopDogDad[1]
TopDogMomOverDad = TopDogMom > TopDogDad
TopDogMomOverZero = TopDogMom > 0

////// Trend Barmeter Calculations //////
// UCS_Trend / Trend Candles Trend Barmeter Calculations
haDataSource = ohlc4
haopen = 0.0
haopen := na(haopen[1]) ? (open + DataSource) / 2 : (haopen[1] + haDataSource[1]) / 2

ccolor = haDataSource - haopen > 0 ? true : false

inside6 = haopen <= math.max(haopen[6], haDataSource[6]) and haopen >= math.min(haopen[6], haDataSource[6]) and haDataSource <= math.max(haopen[6], haDataSource[6]) and haDataSource >= math.min(haopen[6], haDataSource[6]) ? true : false
inside5 = haopen <= math.max(haopen[5], haDataSource[5]) and haopen >= math.min(haopen[5], haDataSource[5]) and haDataSource <= math.max(haopen[5], haDataSource[5]) and haDataSource >= math.min(haopen[5], haDataSource[5]) ? true : false
inside4 = haopen <= math.max(haopen[4], haDataSource[4]) and haopen >= math.min(haopen[4], haDataSource[4]) and haDataSource <= math.max(haopen[4], haDataSource[4]) and haDataSource >= math.min(haopen[4], haDataSource[4]) ? true : false
inside3 = haopen <= math.max(haopen[3], haDataSource[3]) and haopen >= math.min(haopen[3], haDataSource[3]) and haDataSource <= math.max(haopen[3], haDataSource[3]) and haDataSource >= math.min(haopen[3], haDataSource[3]) ? true : false
inside2 = haopen <= math.max(haopen[2], haDataSource[2]) and haopen >= math.min(haopen[2], haDataSource[2]) and haDataSource <= math.max(haopen[2], haDataSource[2]) and haDataSource >= math.min(haopen[2], haDataSource[2]) ? true : false
inside1 = haopen <= math.max(haopen[1], haDataSource[1]) and haopen >= math.min(haopen[1], haDataSource[1]) and haDataSource <= math.max(haopen[1], haDataSource[1]) and haDataSource >= math.min(haopen[1], haDataSource[1]) ? true : false

colorvalue = inside6 ? ccolor[6] : inside5 ? ccolor[5] : inside4 ? ccolor[4] : inside3 ? ccolor[3] : inside2 ? ccolor[2] : inside1 ? ccolor[1] : ccolor

TrendBarTrend_Candle_Color = colorvalue ? colorLong : colorShort
TrendBarTrend_Candle = colorvalue

// RSI 5 Trend Barmeter Calculations
RSI5 = ta.rsi(DataSource, 5)
RSI5Above50 = RSI5 > 50
RSI5Color = RSI5Above50 ? colorLong : colorShort
TrendBarRSI5Color = RSI5Above50 ? colorLong : colorShort

// RSI 13 Trend Barmeter Calculations
RSI13 = ta.rsi(DataSource, 13)

// Linear Regression Calculation For RSI Signal Line
SignalLineLength1 = 21
x = bar_index
y = RSI13
x_ = ta.sma(x, SignalLineLength1)
y_ = ta.sma(y, SignalLineLength1)
mx = ta.stdev(x, SignalLineLength1)
my = ta.stdev(y, SignalLineLength1)
c = ta.correlation(x, y, SignalLineLength1)
slope = c * (my / mx)
inter = y_ - slope * x_
LinReg1 = x * slope + inter

RSISigDirection = LinReg1 > LinReg1[1]
RSISigCross = RSI13 > LinReg1
RSI13Above50 = RSI13 > 50

// Trend Barmeter Color Calculation
RSI13Color = RSI13Above50 ? colorLong : colorShort
TrendBarRSI13Color = RSI13Above50 ? colorLong : colorShort
TrendBarRSISigCrossColor = RSISigCross ? colorLong : colorShort
TrendBarMACDColor = MACDHistogramCross ? colorLong : colorShort
TrendBarFastMACDColor = FastMACDHistogramCross ? colorLong : colorShort
TrendBarMACrossColor = MACrossover1 ? colorLong : colorShort
TrendBarMomOverDadColor = TopDogMomOverDad ? colorLong : colorShort
TrendBarDadDirectionColor = TopDogDadDirection ? colorLong : colorShort

TrendBar1Result = TrendBar1 == OPT_MA_CROSSOVER ? MACrossover1 : TrendBar1 == OPT_MACD_CROSSOVER_12_26_9 ? MACDHistogramCross : TrendBar1 == OPT_MACD_CROSSOVER_FAST ? FastMACDHistogramCross : TrendBar1 == OPT_MOM_DAD_CROSS ? TopDogMomOverDad : TrendBar1 == OPT_DAD_DIRECTION ? TopDogDadDirection : TrendBar1 == OPT_RSI_SIG_CROSS ? RSISigCross : TrendBar1 == OPT_RSI_5_50 ? RSI5Above50 : TrendBar1 == OPT_RSI_13_50 ? RSI13Above50 : TrendBar1 == OPT_TREND_CANDLES ? TrendBarTrend_Candle : false
TrendBar2Result = TrendBar2 == OPT_MA_CROSSOVER ? MACrossover1 : TrendBar2 == OPT_MACD_CROSSOVER_12_26_9 ? MACDHistogramCross : TrendBar2 == OPT_MACD_CROSSOVER_FAST ? FastMACDHistogramCross : TrendBar2 == OPT_MOM_DAD_CROSS ? TopDogMomOverDad : TrendBar2 == OPT_DAD_DIRECTION ? TopDogDadDirection : TrendBar2 == OPT_RSI_SIG_CROSS ? RSISigCross : TrendBar2 == OPT_RSI_5_50 ? RSI5Above50 : TrendBar2 == OPT_RSI_13_50 ? RSI13Above50 : TrendBar2 == OPT_TREND_CANDLES ? TrendBarTrend_Candle : false
TrendBar3Result = TrendBar3 == OPT_MA_CROSSOVER ? MACrossover1 : TrendBar3 == OPT_MACD_CROSSOVER_12_26_9 ? MACDHistogramCross : TrendBar3 == OPT_MACD_CROSSOVER_FAST ? FastMACDHistogramCross : TrendBar3 == OPT_MOM_DAD_CROSS ? TopDogMomOverDad : TrendBar3 == OPT_DAD_DIRECTION ? TopDogDadDirection : TrendBar3 == OPT_RSI_SIG_CROSS ? RSISigCross : TrendBar3 == OPT_RSI_5_50 ? RSI5Above50 : TrendBar3 == OPT_RSI_13_50 ? RSI13Above50 : TrendBar3 == OPT_TREND_CANDLES ? TrendBarTrend_Candle : false

TrendBars3Positive = TrendBar1Result and TrendBar2Result and TrendBar3Result
TrendBars3Negative = not TrendBar1Result and not TrendBar2Result and not TrendBar3Result

PositiveWaveTrendCross = WTCross and WTCrossUp
NegativeWaveTrendCross = WTCross and WTCrossDown

///////////////////////////////////////////////////////////////////////////////////////////////////////////////
isBullishTrendBar = TrendBars3Positive and not TrendBars3Positive[1]
isBearishTrendBar = TrendBars3Negative and not TrendBars3Negative[1]

// Signals Color Calculations
MSBar2Color = isBullishTrendBar ? colorLong : isBearishTrendBar ? colorShort : colorNeutral

// Trend Barmeter Color Assignments
TrendBar1Color = TrendBar1 == OPT_NA ? colorNeutral : TrendBar1 == OPT_MACD_CROSSOVER_12_26_9 ? TrendBarMACDColor : TrendBar1 == OPT_MACD_CROSSOVER_FAST ? TrendBarFastMACDColor : TrendBar1 == OPT_MOM_DAD_CROSS ? TrendBarMomOverDadColor : TrendBar1 == OPT_DAD_DIRECTION ? TrendBarDadDirectionColor : TrendBar1 == OPT_RSI_SIG_CROSS ? TrendBarRSISigCrossColor : TrendBar1 == OPT_RSI_5_50 ? TrendBarRSI5Color : TrendBar1 == OPT_RSI_13_50 ? TrendBarRSI13Color : TrendBar1 == OPT_TREND_CANDLES ? TrendBarTrend_Candle_Color : TrendBar1 == OPT_MA_CROSSOVER ? TrendBarMACrossColor : colorNeutral
TrendBar2Color = TrendBar2 == OPT_NA ? colorNeutral : TrendBar2 == OPT_MACD_CROSSOVER_12_26_9 ? TrendBarMACDColor : TrendBar2 == OPT_MACD_CROSSOVER_FAST ? TrendBarFastMACDColor : TrendBar2 == OPT_MOM_DAD_CROSS ? TrendBarMomOverDadColor : TrendBar2 == OPT_DAD_DIRECTION ? TrendBarDadDirectionColor : TrendBar2 == OPT_RSI_SIG_CROSS ? TrendBarRSISigCrossColor : TrendBar2 == OPT_RSI_5_50 ? TrendBarRSI5Color : TrendBar2 == OPT_RSI_13_50 ? TrendBarRSI13Color : TrendBar2 == OPT_TREND_CANDLES ? TrendBarTrend_Candle_Color : TrendBar2 == OPT_MA_CROSSOVER ? TrendBarMACrossColor : colorNeutral
TrendBar3Color = TrendBar3 == OPT_NA ? colorNeutral : TrendBar3 == OPT_MACD_CROSSOVER_12_26_9 ? TrendBarMACDColor : TrendBar3 == OPT_MACD_CROSSOVER_FAST ? TrendBarFastMACDColor : TrendBar3 == OPT_MOM_DAD_CROSS ? TrendBarMomOverDadColor : TrendBar3 == OPT_DAD_DIRECTION ? TrendBarDadDirectionColor : TrendBar3 == OPT_RSI_SIG_CROSS ? TrendBarRSISigCrossColor : TrendBar3 == OPT_RSI_5_50 ? TrendBarRSI5Color : TrendBar3 == OPT_RSI_13_50 ? TrendBarRSI13Color : TrendBar3 == OPT_TREND_CANDLES ? TrendBarTrend_Candle_Color : TrendBar3 == OPT_MA_CROSSOVER ? TrendBarMACrossColor : colorNeutral

CrossoverType2 = TrendBar4 == OPT_DAD_DIRECTION ? TopDogDadDirection : TrendBar4 == OPT_MACD_CROSSOVER ? MACDHistogramCross : TrendBar4 == OPT_MA_DIR_FAST_TB1 ? MA1Direction : TrendBar4 == OPT_MA_DIR_SLOW_TB1 ? MA2Direction : MACrossover1

isBullishTrendBar4 = TrendBar4 != OPT_NA and CrossoverType2
isBearishTrendBar4 = TrendBar4 != OPT_NA and not CrossoverType2

TrendBar4Color1 = isBullishTrendBar4 ? colorLong : isBearishTrendBar4 ? colorShort : colorNeutral


CrossoverType3 = TrendBar5 == OPT_DAD_DIRECTION ? TopDogDadDirection : TrendBar5 == OPT_MACD_CROSSOVER ? MACDHistogramCross : TrendBar5 == OPT_MA_DIR_FAST_TB2 ? MA3Direction : TrendBar5 == OPT_MA_DIR_SLOW_TB2 ? MA4Direction : MACrossover2

isBullishTrendBar5 = TrendBar5 != OPT_NA and CrossoverType3
isBearishTrendBar5 = TrendBar5 != OPT_NA and not CrossoverType3
TrendBar5Color1 = isBullishTrendBar5 ? colorLong : isBearishTrendBar5 ? colorShort : colorNeutral

WTVOB = wt1 > 60
WTVOS = wt1 < -60

// Weekness / Pos/Neg Pressure
YellowWavePointingUp = YellowWave > YellowWave[1]

RSI14 = ta.rsi(DataSource, 14)
RSI14OB = RSI14 > 70 ? true : false
RSI14OS = RSI14 < 30 ? true : false

OBIndicatorsYellowPointingDown = (RSI14OB or RSI14OB[1]) and WTVOB and not YellowWavePointingUp
OSIndicatorsYellowPointingUp = (RSI14OS or RSI14OS[1]) and WTVOS and YellowWavePointingUp

isPosNegPressureBullish = PosNegPressure and OSIndicatorsYellowPointingUp
isPosNegPressureBearish = PosNegPressure and OBIndicatorsYellowPointingDown

// MAs calculations
// Setting de MAS type
maSource(float source, int length, simple string maType) =>
    switch maType
        "SMA" => ta.sma(DataSource, length)
        "EMA" => ta.ema(DataSource, length)
        "SMMA (RMA)" => ta.rma(source, length)
        "WMA" => ta.wma(source, length)
        "VWMA" => ta.vwma(source, length)

maFastSource = maSource(DataSource, fastEmaPeriod, maType)
maSlowSource = maSource(DataSource, slowEmaPeriod, maType)

isMaBearish = maSlowSource > maFastSource
isMaBullish = maSlowSource < maFastSource

//******************************************************************************************************************************************************
// Fuzzy logic calculations
//******************************************************************************************************************************************************
totalWeight = isPosNegPressureBullishWeight + isPosNegPressureBearishWeight + isBullishTrendBarWeight + isBearishTrendBarWeight + MACDHistogramCrossWeight + FastMACDHistogramCrossWeight + TopDogMomOverDadWeight + TopDogDadDirectionWeight + RSISigCrossWeight + RSI5Above50Weight + RSI13Above50Weight + colorvalueWeight + MACrossover1Weight + isBullishTrendBar4Weight + isBearishTrendBar4Weight + isBullishTrendBar5Weight + isBearishTrendBar5Weight

isPosNegPressureBullishWeight := totalWeight > 0 ? isPosNegPressureBullishWeight / totalWeight * 100 : 0
isPosNegPressureBearishWeight := totalWeight > 0 ? isPosNegPressureBearishWeight / totalWeight * 100 : 0
isBullishTrendBarWeight := totalWeight > 0 ? isBullishTrendBarWeight / totalWeight * 100 : 0
isBearishTrendBarWeight := totalWeight > 0 ? isBearishTrendBarWeight / totalWeight * 100 : 0
MACDHistogramCrossWeight := totalWeight > 0 ? MACDHistogramCrossWeight / totalWeight * 100 : 0
FastMACDHistogramCrossWeight := totalWeight > 0 ? FastMACDHistogramCrossWeight / totalWeight * 100 : 0
TopDogMomOverDadWeight := totalWeight > 0 ? TopDogMomOverDadWeight / totalWeight * 100 : 0
TopDogDadDirectionWeight := totalWeight > 0 ? TopDogDadDirectionWeight / totalWeight * 100 : 0
RSISigCrossWeight := totalWeight > 0 ? RSISigCrossWeight / totalWeight * 100 : 0
RSI5Above50Weight := totalWeight > 0 ? RSI5Above50Weight / totalWeight * 100 : 0
RSI13Above50Weight := totalWeight > 0 ? RSI13Above50Weight / totalWeight * 100 : 0
colorvalueWeight := totalWeight > 0 ? colorvalueWeight / totalWeight * 100 : 0
MACrossover1Weight := totalWeight > 0 ? MACrossover1Weight / totalWeight * 100 : 0
isBullishTrendBar4Weight := totalWeight > 0 ? isBullishTrendBar4Weight / totalWeight * 100 : 0
isBearishTrendBar4Weight := totalWeight > 0 ? isBearishTrendBar4Weight / totalWeight * 100 : 0
