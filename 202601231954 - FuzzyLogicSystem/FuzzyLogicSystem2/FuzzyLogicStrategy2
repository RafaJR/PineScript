//@version=6
strategy(title = 'Fuzzy Logic System Basic Strategy', shorttitle = 'FuzzyLogicSystemBasicStrategy2', overlay = true, pyramiding = 0, calc_on_order_fills = false, commission_type = strategy.commission.percent, commission_value = 0.25, default_qty_type = strategy.percent_of_equity, default_qty_value = 95, initial_capital = 100, currency = currency.USD,  margin_long = 100,  margin_short = 100)

//******************************************************************************************************************************************************
// Configuration inputs
//******************************************************************************************************************************************************
// StopLoss / TakeProffit percents
stopLossPercent = input.int(defval = 1, title = 'Porcentaje de Stop Loss (%)', group = 'Risk control', step = 1)

maType = input.string(defval = "VWMA", title = "Basis MA Type", options = ["SMA", "EMA", "SMMA (RMA)", "WMA", "VWMA"], group="Averange")
fastEmaPeriod = input.int(defval = 50, title = "Fast EMA", minval=1, step = 10, inline="Fast EMA", group="EMAs")
slowEmaPeriod = input.int(defval = 200, title = "Slow EMA", minval=1, step = 10, inline="Slow EMA", group="EMAs")
int fastMacdInput = input.int(defval = 12, title = 'Fast length', step = 1, group = 'MACD')
int slowMacdInput = input.int(defval = 26, title = 'Slow length', step = 1, group = 'MACD')
int sigLenInput = input.int(defval = 9, title = 'Signal length', step = 1, group = 'MACD')
int adxDiLength = input.int(defval = 14, title = 'ADX DI length', step = 1, group = 'ADX')
int adxSmoothing = input.int(defval = 14, title = 'ADX smoothing', step = 1, group = 'ADX')
float adxTrendThreshold = input.float(defval = 25.0, title = 'ADX trend threshold', step = 0.1, group = 'ADX')
int superTrendAtrLength = input.int(defval = 10, title = 'SuperTrend ATR length', minval = 1, step = 1, group = 'SuperTrend')
float superTrendFactor = input.float(defval = 3.0, title = 'SuperTrend factor', minval = 0.1, step = 0.1, group = 'SuperTrend')
int rsiLength = input.int(defval = 14, title = 'RSI length', minval = 1, step = 1, group = 'RSI')
float rsiOverboughtLevel = input.float(defval = 70.0, title = 'RSI overbought level', minval = 0, maxval = 100, step = 1, group = 'RSI')
float rsiOversoldLevel = input.float(defval = 30.0, title = 'RSI oversold level', minval = 0, maxval = 100, step = 1, group = 'RSI')
int atrLength = input.int(defval = 14, title = 'ATR length', minval = 1, step = 1, group = 'ATR')
int bollingerBandsLength = input.int(defval = 20, title = 'Bollinger Bands length', minval = 1, step = 1, group = 'Bollinger Bands')
float bollingerBandsMultiplier = input.float(defval = 2.0, title = 'Bollinger Bands multiplier', minval = 0.1, step = 0.1, group = 'Bollinger Bands')
int alligatorJawLength = input.int(defval = 13, title = 'Jaw length', minval = 1, step = 1, group = 'Williams Alligator')
int alligatorJawOffset = input.int(defval = 8, title = 'Jaw offset', minval = 0, step = 1, group = 'Williams Alligator')
int alligatorTeethLength = input.int(defval = 8, title = 'Teeth length', minval = 1, step = 1, group = 'Williams Alligator')
int alligatorTeethOffset = input.int(defval = 5, title = 'Teeth offset', minval = 0, step = 1, group = 'Williams Alligator')
int alligatorLipsLength = input.int(defval = 5, title = 'Lips length', minval = 1, step = 1, group = 'Williams Alligator')
int alligatorLipsOffset = input.int(defval = 3, title = 'Lips offset', minval = 0, step = 1, group = 'Williams Alligator')
start = input.float(defval = 0.02, title = 'Start', group = 'SAR', step = 0.01)
increment = input.float(defval = 0.02, title = 'Increment', group = 'SAR', step = 0.01)
maximum = input.float(defval = 0.2, title = 'Maximun', group = 'SAR', step = 0.01)

// Data source Configuration
DataSource = input.source(defval = hl2, title="Prize data source", group="General configuration")

// Fuzzy logic weight inputs
int defaultWeight = 60
int nullWeight = 0
int maxWeight = 100000
int defaultStep = 10
maWeight = input.float(title = 'maWeight', defval = defaultWeight, minval = nullWeight, maxval = maxWeight, group = "Fuzzy logic weigth", step = defaultStep)
macdWeight = input.float(title = 'macdWeight', defval = defaultWeight, minval = nullWeight, maxval = maxWeight, group = "Fuzzy logic weigth", step = defaultStep)
adxWeight = input.float(title = 'adxWeight', defval = defaultWeight, minval = nullWeight, maxval = maxWeight, group = "Fuzzy logic weigth", step = defaultStep)
superTrendWeight = input.float(title = 'superTrendWeight', defval = defaultWeight, minval = nullWeight, maxval = maxWeight, group = "Fuzzy logic weigth", step = defaultStep)
rsiWeight = input.float(title = 'rsiWeight', defval = nullWeight, minval = nullWeight, maxval = maxWeight, group = "Fuzzy logic weigth", step = defaultStep)
vwapWeight = input.float(title = 'vwapWeight', defval = nullWeight, minval = nullWeight, maxval = maxWeight, group = "Fuzzy logic weigth", step = defaultStep)
atrWeight  = input.float(title = 'atrWeight', defval = nullWeight, minval = nullWeight, maxval = maxWeight, group = "Fuzzy logic weigth", step = defaultStep)
bollingerBandsWeight = input.float(title = 'bollingerBandsWeight', defval = defaultWeight, minval = nullWeight, maxval = maxWeight, group = "Fuzzy logic weigth", step = defaultStep)
alligatorWeight = input.float(title = 'alligatorWeight', defval = defaultWeight, minval = nullWeight, maxval = maxWeight, group = "Fuzzy logic weigth", step = defaultStep)
parabolicSarWeight = input.float(title = 'parabolicSarWeight', defval = defaultWeight, minval = nullWeight, maxval = maxWeight, group = "Fuzzy logic weigth", step = defaultStep)
parabolicSarStartWeight = input.float(title = 'parabolicSarStartWeight', defval = nullWeight, minval = nullWeight, maxval = maxWeight, group = "Fuzzy logic weigth", step = defaultStep)

// Percentual singnals
bullishSignalPercent = input.float(title = 'bullishSignalPercent', defval = 90, minval = 0, maxval = 100, group = "Fuzzy logic", step = 1)
bullishOutSignalPercent = input.float(title = 'bullishOutSignalPercent', defval = 5, minval = 0, maxval = 100, group = "Fuzzy logic", step = 1)
bearishSignalPercent = input.float(title = 'bearishSignalPercent', defval = -90, minval =-100, maxval = 0, group = "Fuzzy logic", step = 1)
bearishOutSignalPercent = input.float(title = 'bearishOutSignalPercent', defval = -5, minval =-100, maxval = 0, group = "Fuzzy logic", step = 1)

// colors
colorLong = #95d697 // Green for bullish movements
colorShort = #eb805c // Red for bearish movements
colorNeutral = #9e9e9e5c // Grey color for ?
//******************************************************************************************************************************************************
// Main indicators calculations
//******************************************************************************************************************************************************
// MAs calculations
// Setting de MAS type
maSource(float source, int length, simple string maType) =>
    switch maType
        "SMA" => ta.sma(DataSource, length)
        "EMA" => ta.ema(DataSource, length)
        "SMMA (RMA)" => ta.rma(source, length)
        "WMA" => ta.wma(source, length)
        "VWMA" => ta.vwma(source, length)

// EMA calculation
maFastSource = maSource(DataSource, fastEmaPeriod, maType)
maSlowSource = maSource(DataSource, slowEmaPeriod, maType)

isMaBearish = maSlowSource > maFastSource
isMaBullish = maSlowSource < maFastSource

// MACD calculation
// Calculate and plot the MACD, signal, and histogram values.
float maFast = maSource(DataSource, fastMacdInput, maType)
float maSlow = maSource(DataSource, slowMacdInput, maType)
float macd = maFast - maSlow
float signal = maSource(macd, sigLenInput, maType)
float hist = macd - signal

isMacdBullish = macd > signal
isMacdBearish = macd < signal

// ADX calculation
[positiveDi, negativeDi, adx] = ta.dmi(adxDiLength, adxSmoothing)

bool isAdxBullish = adx >= adxTrendThreshold and positiveDi > negativeDi
bool isAdxBearish = adx >= adxTrendThreshold and negativeDi > positiveDi

// SuperTrend calculation
[superTrend, superTrendDirection] = ta.supertrend(superTrendFactor, superTrendAtrLength)

bool isSuperTrendBullish = superTrendDirection < 0
bool isSuperTrendBearish = superTrendDirection > 0

// RSI calculation
float rsi = ta.rsi(DataSource, rsiLength)

bool isRsiBullish = rsi <= rsiOversoldLevel
bool isRsiBearish = rsi >= rsiOverboughtLevel

// VWAP calculation
float vwap = ta.vwap(DataSource)

bool isVwapBullish = DataSource > vwap
bool isVwapBearish = DataSource < vwap

// ATR calculation
float atr = ta.atr(atrLength)
bool isAtrIncreasing = atr > atr[1]

bool isAtrBullish = isAtrIncreasing and close > open
bool isAtrBearish = isAtrIncreasing and close < open

// Bollinger Bands calculation
[bollingerBandsBasis, bollingerBandsUpper, bollingerBandsLower] = ta.bb(DataSource, bollingerBandsLength, bollingerBandsMultiplier)

bool isBollingerBandsBullish = DataSource <= bollingerBandsLower or DataSource > bollingerBandsBasis
bool isBollingerBandsBearish = DataSource >= bollingerBandsUpper or DataSource < bollingerBandsBasis

// Alligator calculation
float alligatorJaw = ta.rma(DataSource, alligatorJawLength)
float alligatorTeeth = ta.rma(DataSource, alligatorTeethLength)
float alligatorLips = ta.rma(DataSource, alligatorLipsLength)

bool isAlligatorBullish = alligatorLips[alligatorLipsOffset] > alligatorTeeth[alligatorTeethOffset] and alligatorTeeth[alligatorTeethOffset] > alligatorJaw[alligatorJawOffset]
bool isAlligatorBearish = alligatorLips[alligatorLipsOffset] < alligatorTeeth[alligatorTeethOffset] and alligatorTeeth[alligatorTeethOffset] < alligatorJaw[alligatorJawOffset]

// Parabolic SAR calculation
out = ta.sar(start, increment, maximum)
// SAR indicates a Bullish trend
isSarBullish = out < DataSource
// SAR Indicates a Bearish trend
isSarBearish = out > DataSource
// A new SAR tendence just started
sarBecomeBearish = isSarBearish and out[1] < DataSource[1]
sarBecomeBullish = isSarBullish and out[1] > DataSource[1]

//******************************************************************************************************************************************************
// Fuzzy logic calculations
//******************************************************************************************************************************************************
totalWeight = maWeight + macdWeight + adxWeight + superTrendWeight + rsiWeight + vwapWeight + atrWeight + bollingerBandsWeight + alligatorWeight + parabolicSarWeight + parabolicSarStartWeight
int percent = 100
maWeight := maWeight / totalWeight * percent
macdWeight := macdWeight / totalWeight * percent
adxWeight := adxWeight / totalWeight * percent
superTrendWeight := superTrendWeight / totalWeight * percent
rsiWeight := rsiWeight / totalWeight * percent
vwapWeight := vwapWeight / totalWeight * percent
atrWeight := atrWeight / totalWeight * percent
bollingerBandsWeight := bollingerBandsWeight / totalWeight * percent
alligatorWeight := alligatorWeight / totalWeight * percent
parabolicSarWeight := parabolicSarWeight / totalWeight * percent
parabolicSarStartWeight := parabolicSarStartWeight / totalWeight * percent

bullishWeightPercentage = (isMaBullish ? maWeight : 0) + (isMacdBullish ? macdWeight : 0) + (isAdxBullish ? adxWeight : 0) + (isSuperTrendBullish ? superTrendWeight : 0) + (isRsiBullish ? rsiWeight : 0) + (isVwapBullish ? vwapWeight : 0) + (isAtrBullish ? atrWeight : 0) + (isBollingerBandsBullish ? bollingerBandsWeight : 0) + (isAlligatorBullish ? alligatorWeight : 0) + (isSarBullish ? parabolicSarWeight : 0) + (sarBecomeBullish ? parabolicSarStartWeight : 0)
bearishWeightPercentage = (isMaBearish ? maWeight : 0) + (isMacdBearish ? macdWeight : 0) + (isAdxBearish ? adxWeight : 0) + (isSuperTrendBearish ? superTrendWeight : 0) + (isRsiBearish ? rsiWeight : 0) + (isVwapBearish ? vwapWeight : 0) + (isAtrBearish ? atrWeight : 0) + (isBollingerBandsBearish ? bollingerBandsWeight : 0) + (isAlligatorBearish ? alligatorWeight : 0) + (isSarBearish ? parabolicSarWeight : 0) + (sarBecomeBearish ? parabolicSarStartWeight : 0)

bearishWeightPercentage := bearishWeightPercentage * -1

//******************************************************************************************************************************************************
// Plotting
//******************************************************************************************************************************************************
// EMAs Plotting
maSourceSlowColor = maSlowSource < DataSource ? colorLong : colorShort
maSourceFastColor = maFastSource < DataSource ? colorLong : colorShort
maSourceSlowPlot = plot(series=maSlowSource, title="maSource", color=maSourceSlowColor, linewidth = 2, force_overlay = true)
maSourceFastPlot = plot(series=maFastSource, title="maSource", color=maSourceFastColor, linewidth = 1, force_overlay = true)

fillMAColor = isMaBearish ? color.new(colorShort, 80) : color.new(colorLong, 80)
fill(maSourceFastPlot, maSourceSlowPlot, color=fillMAColor, fillgaps=true)

// Fuzzy logic oscilator
hline(100, title = 'Fuzzy Logic Maximum', color = color.new(color.white, 70))
bullishSignalPercentPlot = plot(bullishSignalPercent, title = 'Fuzzy Logic Maximum', color = colorLong)
// Out zone
bearishOutSignalPercentPlot = plot(bearishOutSignalPercent, title = 'FuzzFy Logic bearishOutSignalPercent', color = color.white)
hline(0, title = 'Fuzzy Logic Zero', color = color.white)
bullishOutSignalPercentPlot = plot(bullishOutSignalPercent, title = 'FuzzFy Logic bullishOutSignalPercent', color = color.white)

bearishSignalPercentPlot = plot(bearishSignalPercent, title = 'Fuzzy Logic Maximum', color = colorShort)
hline(-100, title = 'Fuzzy Logic Minimum', color = color.new(color.white, 70))
bullishWeightPercentagePlot = plot(bullishWeightPercentage, title = 'Bullish Weight Percentage', color = colorLong, linewidth = 1, force_overlay = false)
bearishWeightPercentagePlot = plot(bearishWeightPercentage, title = 'Bearish Weight Percentage', color = colorShort, linewidth = 1, force_overlay = false)
fillFuzzyBullishColor = bullishWeightPercentage >= bullishSignalPercent ? color.new(colorLong, 60) : color.new(color.black, 100)
fillFuzzyBearishColor = bearishWeightPercentage <= bearishSignalPercent ? color.new(colorShort, 60) : color.new(color.black, 100)
//fill(bearishOutSignalPercentPlot, bullishOutSignalPercentPlot, color=fillMAColor, fillgaps=true)
fill(bullishWeightPercentagePlot, bullishSignalPercentPlot, color=fillFuzzyBullishColor, fillgaps=true)
fill(bearishWeightPercentagePlot, bearishSignalPercentPlot, color=fillFuzzyBearishColor, fillgaps=true)

fill(bearishOutSignalPercentPlot, bullishOutSignalPercentPlot, color=color.new(color.white, 90), fillgaps=true)
fillFuzzyOutBullishColor = bullishWeightPercentage <= bullishOutSignalPercent ? color.new(colorShort, 60) : color.new(color.black, 100)
fill(bullishWeightPercentagePlot, bullishOutSignalPercentPlot, color=fillFuzzyOutBullishColor, fillgaps=true)
fillFuzzyOutBearishColor = bearishWeightPercentage >= bearishOutSignalPercent ? color.new(colorLong, 60) : color.new(color.black, 100)
fill(bearishWeightPercentagePlot, bearishOutSignalPercentPlot, color=fillFuzzyOutBearishColor, fillgaps=true)

//***************************************************************************************************************************************************************
// Operation orders
//***************************************************************************************************************************************************************
// Entry vars inicialization
var bool killLongEntry = false
var bool killShortEntry = false
var bool longEntry = false
var bool shortEntry = false
var bool operationalBusy = false

// Entry conditions
longEntry := ta.crossover(bullishWeightPercentage, bullishSignalPercent)
killLongEntry := bullishWeightPercentage <= bullishOutSignalPercent
shortEntry := ta.crossunder(bearishWeightPercentage, bearishSignalPercent)
killShortEntry := bearishWeightPercentage >= bearishOutSignalPercent

// Time parameters for testing
//if (year == 2025 and month == 1 and dayofmonth >= 6 and dayofmonth <= 7)
//if (year == currentYear and month == currentMonth)
//if (year == currentYear)
if (true)
    // Operation nomenclature variables
    var int longOpCount = 0
    var int shortOpCount = 0
    var string longOpName = ""
    var string shortOpName = ""

    if(killLongEntry)
        strategy.close(id=longOpName)
        operationalBusy := false
    if(killShortEntry)
        strategy.close(id=shortOpName)
        operationalBusy := false
    if (longEntry and not operationalBusy)
        longOpCount += 1
        longOpName := "Long"
        longOpComment = longOpName + str.tostring(longOpCount)
        strategy.entry(id=longOpName, direction=strategy.long, comment=longOpComment)
        stopLossPrize = strategy.position_avg_price * (1 - stopLossPercent / 100)
        strategy.exit(id=longOpName, from_entry=longOpName, comment=longOpComment, stop=stopLossPrize, comment_profit = "TP" + str.tostring(longOpCount), comment_loss = "SL" + str.tostring(longOpCount))
        operationalBusy := true
    if (shortEntry and not operationalBusy)
        shortOpCount += 1
        shortOpName := "Short"
        shortOpComment = shortOpName + str.tostring(shortOpCount)
        strategy.entry(id=shortOpName, direction=strategy.short, comment=shortOpComment)
        stopLossPrize = strategy.position_avg_price * (1 + stopLossPercent / 100)
        strategy.exit(id=shortOpName, from_entry=shortOpName, comment=shortOpComment, stop=stopLossPrize, comment_profit = "TP" + str.tostring(shortOpCount), comment_loss = "SL" + str.tostring(longOpCount))
        operationalBusy := true
    if (strategy.position_size == 0)
        operationalBusy := false
